# URL HTTPS que o Dokploy atribuirá ao serviço evolution-api (porta 8080).
EVOLUTION_SERVER_URL=https://evolution.seudominio.com.br

# Gere valores longos e aleatórios fora do repositório.
EVOLUTION_API_KEY=SUBSTITUA_POR_CHAVE_ALEATORIA_LONGA
EVOLUTION_POSTGRES_DB=evolution
EVOLUTION_POSTGRES_USER=evolution
EVOLUTION_POSTGRES_PASSWORD=SUBSTITUA_POR_SENHA_ALEATORIA_LONGA

# URI interna do Postgres do Compose. Codifique caracteres especiais da senha.
EVOLUTION_DATABASE_CONNECTION_URI=postgresql://evolution:SENHA_CODIFICADA@evolution-postgres:5432/evolution
